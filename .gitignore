# Ignore bundler config and local gems.
/.bundle
/vendor/bundle

# Environment files.
/.env*
!/.env*.erb

# Logs, temp, and OS files.
/log/*
/tmp/*
.DS_Store

# Frontend
/frontend/node_modules
/frontend/dist
/frontend/.angular

# Go
/personalization/bin

# Rails master key lives in backend/.gitignore as well.
/backend/config/master.key
