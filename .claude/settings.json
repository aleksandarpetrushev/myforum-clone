{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/run-matching-tests.sh",
            "timeout": 180,
            "statusMessage": "Running the matching tests…"
          }
        ]
      }
    ]
  }
}
